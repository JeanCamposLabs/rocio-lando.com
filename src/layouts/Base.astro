---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import site from '../data/site';
import { withBase } from '../lib/path';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noLoader?: boolean;
  bareNav?: boolean;
}

const {
  title,
  description = site.seo.description,
  image = site.seo.ogImage,
  noLoader = false,
  bareNav = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.seo.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://rocio-lando.com').href;
const ogImage = new URL(image, Astro.site ?? 'https://rocio-lando.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.seo.description,
  url: 'https://rocio-lando.com',
  email: site.email,
  address: site.location,
  sameAs: site.socials.filter((s) => s.url.startsWith('http')).map((s) => s.url),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme + JS flag: set before paint to avoid any flash -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        el.classList.add('js');
        try {
          const stored = localStorage.getItem('rl-theme');
          const prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          el.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
          // Show the intro preloader only once per browser session
          if (sessionStorage.getItem('rl-seen')) el.classList.add('seen');
          else sessionStorage.setItem('rl-seen', '1');
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f1ead9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/site/icon-180.png')} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    {!noLoader && <Preloader />}
    <Cursor />
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>

    <Nav bare={bareNav} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: var(--z-loader);
        padding: 0.7em 1.2em;
        background: var(--ink);
        color: var(--paper);
        border-radius: 100px;
        transition: top 0.3s var(--ease-out-quart);
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
