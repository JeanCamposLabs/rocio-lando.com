---
import { getCollection } from 'astro:content';
import Pic from './Pic.astro';
import manifest from '../data/image-manifest.json';

const CATEGORY_LABELS: Record<string, string> = {
  architecture: 'Architecture',
  watercolor: 'Watercolour',
  animals: 'Animals',
  botanical: 'Botanical',
  travel: 'Travel',
};
const CATEGORY_ORDER = ['architecture', 'watercolor', 'animals', 'botanical', 'travel'];

const works = (await getCollection('works'))
  .filter((w) => !w.data.draft)
  .sort(
    (a, b) =>
      a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0)
  );

const presentCats = CATEGORY_ORDER.filter((c) =>
  works.some((w) => w.data.category === c)
);

const fullSrc = (img?: string) => {
  if (!img) return '';
  const e = (manifest as Record<string, any>)[img];
  return e ? e.sources[e.sources.length - 1].src : img;
};

const realCount = works.filter((w) => !w.data.placeholder).length;
const sizes = '(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 29vw';
---

<section class="gallery section" id="work">
  <div class="container container--wide">
    <header class="gallery__head">
      <div>
        <p class="eyebrow" data-reveal="fade">Selected work · {realCount} pieces &amp; counting</p>
        <h2 class="section-title gallery__title" data-reveal>The sketchbook,<br />unbound.</h2>
      </div>
      <p class="gallery__intro lead" data-reveal style="--reveal-delay:.1s">
        A living gallery of ink and watercolour. Filter by what you love — then tap any
        piece to see it full-bleed.
      </p>
    </header>

    <div class="gallery__filters" role="tablist" aria-label="Filter works by category" data-filters>
      <button class="chip is-active" role="tab" aria-selected="true" data-filter="all" data-cursor-hover>
        All
      </button>
      {presentCats.map((c) => (
        <button class="chip" role="tab" aria-selected="false" data-filter={c} data-cursor-hover>
          {CATEGORY_LABELS[c] ?? c}
        </button>
      ))}
    </div>

    <div class="gallery__grid" data-gallery data-lb-group="gallery">
      {works.map((w, i) => {
        const d = w.data;
        const isPlaceholder = d.placeholder || !d.image;
        return (
          <figure
            class:list={['work', { 'work--placeholder': isPlaceholder }]}
            data-work
            data-category={d.category}
            data-index={i}
            data-full={fullSrc(d.image)}
            data-title={d.title}
            data-meta={[d.medium, d.year, d.location].filter(Boolean).join(' · ')}
            data-alt={d.alt || d.title}
            data-caption={d.description ?? ''}
            tabindex={isPlaceholder ? -1 : 0}
            role={isPlaceholder ? undefined : 'button'}
            aria-label={isPlaceholder ? undefined : `View ${d.title}`}
            data-cursor-view={isPlaceholder ? undefined : 'view'}
          >
            {isPlaceholder ? (
              <div class="work__placeholder">
                <span class="work__placeholder-plus" aria-hidden="true">＋</span>
                <span class="work__placeholder-text font-hand">a new piece, soon</span>
              </div>
            ) : (
              <div class="work__media">
                <Pic src={d.image!} alt={d.alt || d.title} sizes={sizes} />
                <figcaption class="work__overlay">
                  <span class="work__cat">{CATEGORY_LABELS[d.category] ?? d.category}</span>
                  <span class="work__title">{d.title}</span>
                  <span class="work__medium">{d.medium}{d.year ? ` · ${d.year}` : ''}</span>
                </figcaption>
              </div>
            )}
          </figure>
        );
      })}
    </div>
  </div>

  <!-- Lightbox (populated by main.ts) -->
  <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true" aria-label="Artwork viewer">
    <button class="lightbox__close" data-lb-close aria-label="Close" data-cursor-hover>✕</button>
    <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous" data-cursor-hover>←</button>
    <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next" data-cursor-hover>→</button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" data-lb-img alt="" />
      <figcaption class="lightbox__cap">
        <span class="lightbox__title" data-lb-title></span>
        <span class="lightbox__meta" data-lb-meta></span>
        <span class="lightbox__desc" data-lb-desc></span>
      </figcaption>
    </figure>
    <span class="lightbox__counter" data-lb-counter></span>
  </div>
</section>

<style>
  .gallery__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 30ch);
    gap: var(--space-l);
    align-items: end;
    margin-bottom: var(--space-l);
  }
  @media (max-width: 760px) {
    .gallery__head {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }
  .gallery__title {
    margin: var(--space-s) 0 0;
  }
  .gallery__intro {
    padding-bottom: 0.4rem;
  }

  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: var(--space-l);
    position: sticky;
    top: calc(var(--header-h) - 24px);
    z-index: 5;
    padding-block: 0.6rem;
  }
  .chip.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
  .chip.is-active:hover {
    color: var(--paper);
  }

  /* Masonry — preserves each drawing's real proportions (no cropping) */
  .gallery__grid {
    column-count: 3;
    column-gap: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  @media (max-width: 1000px) {
    .gallery__grid {
      column-count: 2;
    }
  }
  @media (max-width: 540px) {
    .gallery__grid {
      column-count: 1;
    }
  }

  .work {
    break-inside: avoid;
    margin-bottom: clamp(0.8rem, 1.5vw, 1.4rem);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    opacity: 0;
    transform: translateY(26px) scale(0.98);
    transition: opacity 0.7s var(--ease-out-expo), transform 0.7s var(--ease-out-expo),
      box-shadow 0.4s ease;
    will-change: opacity, transform;
  }
  .work.is-revealed {
    opacity: 1;
    transform: none;
  }
  .work.is-hidden {
    display: none;
  }
  .work:not(.work--placeholder):hover {
    box-shadow: var(--shadow-l);
  }
  .work__media {
    position: relative;
    cursor: pointer;
  }
  .work__media :global(img) {
    transition: transform 0.7s var(--ease-out-quart), filter 0.5s ease;
  }
  .work:hover .work__media :global(img.is-loaded) {
    transform: scale(1.04);
  }
  .work__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.15rem;
    padding: var(--space-m);
    color: #fff;
    background: linear-gradient(0deg, rgb(0 0 0 / 0.62), rgb(0 0 0 / 0.1) 45%, transparent 70%);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out-quart);
  }
  .work:hover .work__overlay,
  .work:focus-visible .work__overlay {
    opacity: 1;
    transform: none;
  }
  .work__cat {
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklab, #fff 78%, transparent);
  }
  .work__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .work__medium {
    font-size: var(--step--1);
    color: color-mix(in oklab, #fff 75%, transparent);
  }

  /* Placeholder slot */
  .work--placeholder {
    border-style: dashed;
    border-color: var(--line-strong);
    background: transparent;
  }
  .work__placeholder {
    aspect-ratio: 4 / 5;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    color: var(--ink-faint);
    text-align: center;
    padding: var(--space-m);
  }
  .work__placeholder-plus {
    font-size: var(--step-5);
    line-height: 1;
    color: var(--accent);
  }
  .work__placeholder-text {
    font-size: var(--step-1);
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: color-mix(in oklab, #0c0a07 88%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s var(--ease-out-quart), visibility 0.45s;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    max-width: min(1100px, 100%);
    max-height: 100%;
    transform: scale(0.94);
    transition: transform 0.5s var(--ease-out-expo);
  }
  .lightbox.is-open .lightbox__figure {
    transform: scale(1);
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 76vh;
    width: auto;
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-l);
    background: var(--paper);
  }
  .lightbox__cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: var(--paper);
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
  }
  .lightbox__meta {
    font-size: var(--step--1);
    color: color-mix(in oklab, #fff 65%, transparent);
    letter-spacing: 0.04em;
  }
  .lightbox__desc {
    font-size: var(--step-0);
    color: color-mix(in oklab, #fff 80%, transparent);
    font-style: italic;
  }
  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    color: var(--paper);
    border: 1px solid color-mix(in oklab, #fff 24%, transparent);
    border-radius: 50%;
    font-size: 1.3rem;
    transition: background 0.3s, transform 0.3s var(--ease-spring), border-color 0.3s;
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .lightbox__close {
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
  }
  .lightbox__nav--prev {
    left: clamp(0.6rem, 3vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__nav--next {
    right: clamp(0.6rem, 3vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__nav--prev:hover {
    transform: translateY(-50%) scale(1.08);
  }
  .lightbox__nav--next:hover {
    transform: translateY(-50%) scale(1.08);
  }
  .lightbox__counter {
    position: absolute;
    bottom: clamp(1rem, 3vw, 2rem);
    left: 50%;
    transform: translateX(-50%);
    color: color-mix(in oklab, #fff 65%, transparent);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }
  @media (max-width: 700px) {
    .lightbox__nav {
      top: auto;
      bottom: clamp(1rem, 3vw, 2rem);
      transform: none;
    }
    .lightbox__nav--prev {
      left: 25%;
    }
    .lightbox__nav--next {
      right: 25%;
    }
    .lightbox__img {
      max-height: 64vh;
    }
  }
</style>
