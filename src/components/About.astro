---
import site from '../data/site';
import { emphasize } from '../data/site';
import Pic from './Pic.astro';
const { about, stats } = site;
---

<section class="about section" id="about">
  <div class="container">
    <div class="about__grid">
      <div class="about__media" data-reveal="left">
        <figure class="about__portrait" data-tilt>
          <Pic
            src={about.portrait}
            alt={about.portraitAlt}
            sizes="(max-width: 900px) 90vw, 40vw"
            fit="cover"
          />
          <figcaption class="about__caption font-hand">studio, somewhere between two coasts</figcaption>
        </figure>
        <span class="about__badge font-hand" aria-hidden="true">drawn by hand ✦ always</span>
      </div>

      <div class="about__body">
        <p class="eyebrow" data-reveal="fade">{about.kicker}</p>
        <h2 class="about__heading" data-reveal>{about.heading}</h2>
        <div class="about__text">
          {about.paragraphs.map((p, i) => (
            <p data-reveal style={`--reveal-delay:${0.1 + i * 0.08}s`} set:html={emphasize(p)} />
          ))}
        </div>
        <p class="about__signature" data-reveal>{about.signature}</p>
      </div>
    </div>

    <ul class="about__stats" role="list">
      {stats.map((s, i) => (
        <li class="about__stat" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <span class="about__stat-value" data-count={s.value}>{s.value}</span>
          <span class="about__stat-label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about__media {
    position: relative;
  }
  .about__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--paper-sunken);
    box-shadow: var(--shadow-l);
    border: 1px solid var(--line);
    transform: rotate(-1.5deg);
    transition: transform 0.6s var(--ease-out-quart);
  }
  .about__portrait:hover {
    transform: rotate(0deg);
  }
  .about__caption {
    position: absolute;
    left: 1rem;
    bottom: 0.6rem;
    color: var(--paper);
    font-size: var(--step-0);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.5);
  }
  .about__badge {
    position: absolute;
    top: -1.2rem;
    right: -0.6rem;
    rotate: 8deg;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--step-0);
    padding: 0.3em 0.9em;
    border-radius: 100px;
    box-shadow: var(--shadow-m);
  }

  .about__heading {
    font-size: var(--step-5);
    font-variation-settings: 'opsz' 144, 'SOFT' 40, 'WONK' 1;
    margin-block: var(--space-s) var(--space-m);
    max-width: 20ch;
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step-0);
    max-width: 56ch;
  }
  .about__signature {
    font-family: var(--font-hand);
    font-size: var(--step-4);
    color: var(--accent);
    margin-top: var(--space-m);
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .about__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .about__stat-value {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
    line-height: 1;
    color: var(--accent);
  }
  .about__stat-label {
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: 18ch;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__media {
      max-width: 380px;
    }
    .about__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-l) var(--space-m);
    }
  }
</style>
