---
import Game from './Game.astro';
---

<section class="play section" id="play">
  <div class="container">
    <header class="play__head">
      <div>
        <p class="eyebrow" data-reveal="fade">An intermission</p>
        <h2 class="section-title play__title" data-reveal>
          Stay a while.<br />Play a little.
        </h2>
      </div>
      <p class="play__intro lead" data-reveal style="--reveal-delay:.1s">
        Every good sketchbook has doodles in the margins. Here's one you can play —
        a small surprise, hand-built just for this page.
        <a href="/play" class="link-underline play__full" data-cursor-hover>Open full screen ↗</a>
      </p>
    </header>

    <div data-reveal="scale" style="--reveal-delay:.1s">
      <Game />
    </div>
  </div>
</section>

<style>
  .play {
    background: var(--paper);
  }
  .play__head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 34ch);
    gap: var(--space-l);
    align-items: end;
    margin-bottom: var(--space-l);
  }
  .play__title {
    margin: var(--space-s) 0 0;
  }
  .play__full {
    display: inline-block;
    margin-top: var(--space-xs);
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .play__head {
      grid-template-columns: 1fr;
    }
  }
</style>
