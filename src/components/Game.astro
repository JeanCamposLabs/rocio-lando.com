---
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<div class:list={['game', { 'game--standalone': standalone }]} data-game>
  <div class="game__frame" data-game-frame>
    <canvas class="game__canvas" data-game-canvas></canvas>

    <div class="game__hud" aria-hidden="true">
      <span class="game__stat">Score <b data-game-score>0</b></span>
      <span class="game__stat game__stat--best">Best <b data-game-best>0</b></span>
      <span class="game__lives" data-game-lives></span>
    </div>

    <button class="game__pausebtn" data-game-pausebtn type="button" aria-label="Pause game" hidden>❚❚</button>

    <!-- Start -->
    <div class="game__screen" data-game-start>
      <span class="game__badge font-hand">a little break ✦</span>
      <h3 class="game__heading">Ink&nbsp;Catch</h3>
      <p class="game__copy">
        Rocío's sketches are tumbling off the page. Catch them in the sketchbook —
        and dodge the spilled ink blots.
      </p>
      <button class="btn game__play" data-game-play type="button" data-cursor-hover>
        Start drawing ✦
      </button>
      <p class="game__controls">
        <span>Move &nbsp;<kbd>←</kbd><kbd>→</kbd>&nbsp; / mouse</span>
        <span>Drag on touch</span>
        <span><kbd>P</kbd> to pause</span>
      </p>
    </div>

    <!-- Pause -->
    <div class="game__screen game__screen--mini" data-game-pause hidden>
      <h3 class="game__heading game__heading--sm">Paused</h3>
      <button class="btn game__play" data-game-resume type="button" data-cursor-hover>Resume</button>
    </div>

    <!-- Game over -->
    <div class="game__screen" data-game-over hidden>
      <span class="game__badge font-hand" data-game-newbest hidden>✦ new personal best ✦</span>
      <h3 class="game__heading game__heading--sm">Out of pages.</h3>
      <p class="game__copy">
        You rescued <b data-game-final>0</b> sketches.
      </p>
      <button class="btn game__play" data-game-replay type="button" data-cursor-hover>Play again</button>
    </div>
  </div>
</div>

<script>
  import '../scripts/game.ts';
</script>

<style>
  .game {
    width: 100%;
  }
  .game__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-l);
    user-select: none;
    touch-action: none;
  }
  .game--standalone .game__frame {
    aspect-ratio: auto;
    height: min(78svh, 760px);
  }
  .game__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: none;
  }
  :global(html:not(.has-cursor)) .game__canvas {
    cursor: grab;
  }

  .game__hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: clamp(0.7rem, 2vw, 1.1rem) clamp(0.9rem, 2.5vw, 1.4rem);
    font-size: var(--step--1);
    color: var(--ink-soft);
    z-index: 3;
    pointer-events: none;
  }
  .game__stat b {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
    margin-left: 0.3em;
  }
  .game__lives {
    margin-left: auto;
    letter-spacing: 0.15em;
    font-size: var(--step-1);
    color: var(--accent);
  }

  .game__pausebtn {
    position: absolute;
    top: clamp(0.6rem, 2vw, 1rem);
    right: clamp(0.6rem, 2vw, 1rem);
    z-index: 4;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--paper) 70%, transparent);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.8rem;
    display: grid;
    place-items: center;
  }

  .game__screen {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-s);
    padding: var(--space-l);
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: opacity 0.4s ease, visibility 0.4s;
  }
  .game__screen[hidden] {
    display: none;
  }
  .game__screen--mini {
    background: color-mix(in oklab, var(--paper) 55%, transparent);
  }
  .game__badge {
    color: var(--accent);
    font-size: var(--step-2);
  }
  .game__heading {
    font-family: var(--font-display);
    font-size: var(--step-7);
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
    line-height: 0.95;
  }
  .game__heading--sm {
    font-size: var(--step-5);
  }
  .game__copy {
    max-width: 40ch;
    color: var(--ink-soft);
  }
  .game__copy b {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.2em;
  }
  .game__play {
    margin-top: var(--space-2xs);
  }
  .game__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.2rem;
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .game__controls kbd {
    font-family: var(--font-sans);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 0.05em 0.4em;
    margin: 0 0.1em;
    font-size: 0.85em;
  }
</style>
