---
import site from '../data/site';
import Pic from './Pic.astro';

// Two columns of artwork that drift vertically behind/beside the headline.
const colA = [
  { src: '/works/urban-facade.jpg', alt: 'Ink sketch of an ornate urban facade.' },
  { src: '/works/danki-dushi-curacao.png', alt: 'Watercolour of colourful Curaçao houses.' },
  { src: '/works/lion.jpg', alt: 'Ink portrait of a lion.' },
  { src: '/works/mont-saint-michel.jpg', alt: 'Ink sketch of Mont-Saint-Michel.' },
  { src: '/works/sunflower.jpg', alt: 'Ink sketch of a sunflower.' },
  { src: '/works/wooden-cabin.jpg', alt: 'Ink sketch of a wooden cabin.' },
];
const colB = [
  { src: '/works/notre-dame-cathedral.jpg', alt: 'Ink drawing of Notre-Dame.' },
  { src: '/works/patio-garden.jpg', alt: 'Watercolour wash of a patio garden.' },
  { src: '/works/the-dome.jpg', alt: 'Ink study of a dome.' },
  { src: '/works/pongo-and-patch.jpg', alt: 'Ink sketches of dalmatian puppies.' },
  { src: '/works/lighthouse-at-night.jpg', alt: 'Ink drawing of a lighthouse at night.' },
  { src: '/works/hornero-bird.jpg', alt: 'Ink illustration of a hornero bird.' },
];
const sizes = '(max-width: 900px) 40vw, 22vw';
---

<section class="hero" id="hero">
  <div class="hero__art" aria-hidden="true">
    <div class="hero__col" data-hero-col="0.06">
      <div class="hero__track">
        {[...colA, ...colA].map((a) => (
          <figure class="hero__frame">
            <Pic src={a.src} alt="" sizes={sizes} loading="eager" />
          </figure>
        ))}
      </div>
    </div>
    <div class="hero__col hero__col--b" data-hero-col="-0.04">
      <div class="hero__track hero__track--rev">
        {[...colB, ...colB].map((a) => (
          <figure class="hero__frame">
            <Pic src={a.src} alt="" sizes={sizes} loading="eager" />
          </figure>
        ))}
      </div>
    </div>
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="container">
      <p class="hero__kicker eyebrow" data-reveal="fade">{site.hero.kicker}</p>
      <h1 class="hero__title">
        <span class="line-mask"><span class="line-inner" style="--line-delay:.05s">{site.hero.headline[0]}</span></span>
        <span class="line-mask"
          ><span class="line-inner" style="--line-delay:.16s"
            >the <em class="italic">unseen.</em></span
          ></span
        >
      </h1>
      <p class="hero__intro" data-reveal style="--reveal-delay:.5s">{site.hero.intro}</p>
      <div class="hero__actions" data-reveal style="--reveal-delay:.62s">
        <a class="btn" href="#work" data-cursor-hover>
          View the work <span class="btn__icon" aria-hidden="true">↗</span>
        </a>
        <a class="btn btn--ghost" href="#contact" data-cursor-hover>Commission a piece</a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#work" aria-label="Scroll to work" data-cursor-hover>
    <span class="hero__scroll-text font-hand">{site.hero.scrollLabel}</span>
    <span class="hero__scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: var(--header-h) var(--space-2xl);
  }

  /* ---- Drifting art columns ---- */
  .hero__art {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    gap: clamp(0.6rem, 1.5vw, 1.4rem);
    padding-right: var(--gutter);
    z-index: 1;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 14%, #000 80%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 14%, #000 80%, transparent);
  }
  .hero__col {
    width: clamp(150px, 22vw, 320px);
    will-change: transform;
  }
  .hero__col--b {
    margin-top: -12%;
  }
  .hero__track {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.5vw, 1.4rem);
    animation: heroScroll 60s linear infinite;
  }
  .hero__track--rev {
    animation-direction: reverse;
    animation-duration: 72s;
  }
  @keyframes heroScroll {
    to {
      transform: translateY(-50%);
    }
  }
  .hero__frame {
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper-raised);
    box-shadow: var(--shadow-m);
    border: 1px solid var(--line);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(95deg, var(--paper) 32%, color-mix(in oklab, var(--paper) 70%, transparent) 56%, transparent 82%);
  }
  @media (max-width: 900px) {
    .hero__scrim {
      background: linear-gradient(180deg, var(--paper) 38%, color-mix(in oklab, var(--paper) 55%, transparent));
    }
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
  }
  .hero__kicker {
    margin-bottom: var(--space-m);
  }
  .hero__title {
    font-size: var(--step-8);
    font-variation-settings: 'opsz' 144, 'SOFT' 30, 'WONK' 1;
    line-height: 0.95;
    max-width: 14ch;
  }
  .hero__title em {
    color: var(--accent);
  }
  .hero__intro {
    margin-top: var(--space-l);
    max-width: 42ch;
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-l);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
  }
  .hero__scroll-text {
    font-size: var(--step-1);
    color: var(--accent);
  }
  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: var(--line-strong);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scrollLine 2s var(--ease-in-out) infinite;
  }
  @keyframes scrollLine {
    0% {
      transform: translateY(-100%);
    }
    50%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-start;
      padding-top: calc(var(--header-h) + var(--space-m));
    }
    .hero__art {
      opacity: 0.5;
    }
    .hero__col {
      width: 40vw;
    }
    .hero__title {
      font-size: clamp(3.2rem, 16vw, 6rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__track {
      animation: none;
    }
  }
</style>
