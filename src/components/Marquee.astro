---
import site from '../data/site';
const items = site.disciplines;
const star = '✦';
---

<section class="disciplines" aria-label="Disciplines">
  <div class="marquee" data-marquee data-reverse>
    <div class="marquee__row" aria-hidden="false">
      {items.map((d) => (
        <span class="disciplines__item">
          {d}
          <span class="disciplines__star">{star}</span>
        </span>
      ))}
    </div>
    <div class="marquee__row" aria-hidden="true">
      {items.map((d) => (
        <span class="disciplines__item">
          {d}
          <span class="disciplines__star">{star}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .disciplines {
    position: relative;
    z-index: var(--z-content);
    padding-block: var(--space-l);
    border-block: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper-raised) 60%, transparent);
  }
  .disciplines__item {
    display: inline-flex;
    align-items: center;
    gap: var(--marquee-gap);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 3rem);
    font-variation-settings: 'opsz' 144, 'SOFT' 40, 'WONK' 1;
    color: var(--ink);
    white-space: nowrap;
  }
  .disciplines__star {
    color: var(--accent);
    font-size: 0.55em;
    transform: translateY(-0.1em);
  }
</style>
