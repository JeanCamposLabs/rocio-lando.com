---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { withBase } from '../../lib/path';

const CATEGORY_LABELS: Record<string, string> = {
  architecture: 'Architecture',
  watercolor: 'Watercolour',
  animals: 'Animals',
  botanical: 'Botanical',
  travel: 'Travel',
};

export async function getStaticPaths() {
  const works = (await getCollection('works'))
    .filter((w) => !w.data.draft && !w.data.placeholder && w.data.image)
    .sort(
      (a, b) =>
        a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0)
    );
  return works.map((w, i) => ({
    params: { slug: w.id },
    props: {
      work: w,
      prev: works[(i - 1 + works.length) % works.length],
      next: works[(i + 1) % works.length],
      related: works
        .filter((x) => x.data.category === w.data.category && x.id !== w.id)
        .slice(0, 3),
    },
  }));
}

const { work, prev, next, related } = Astro.props;
const d = work.data;
const { Content } = await render(work);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.title,
  creator: { '@type': 'Person', name: 'Rocío Landó' },
  artform: d.medium,
  artMedium: d.medium,
  dateCreated: d.year,
  locationCreated: d.location || undefined,
  image: new URL(d.image!, 'https://rocio-lando.com').href,
};
---

<Base title={d.title} description={d.alt || `${d.title} — ${d.medium} by Rocío Landó.`} image={d.image}>
  <article class="wp">
    <div class="container">
      <nav class="wp__crumbs">
        <a href={withBase('/') + '#work'} class="link-underline" data-cursor-hover>← All work</a>
        <span class="wp__cat chip">{CATEGORY_LABELS[d.category] ?? d.category}</span>
      </nav>

      <header class="wp__head">
        <h1 class="wp__title">{d.title}</h1>
        <dl class="wp__meta">
          <div><dt>Medium</dt><dd>{d.medium}</dd></div>
          {d.year && <div><dt>Year</dt><dd>{d.year}</dd></div>}
          {d.location && <div><dt>Place</dt><dd>{d.location}</dd></div>}
        </dl>
      </header>

      <figure class="wp__figure" data-reveal="scale">
        <Pic
          src={d.image!}
          alt={d.alt || d.title}
          sizes="(max-width: 1000px) 94vw, 70vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="wp__body">
        {d.description && <p class="wp__desc">{d.description}</p>}
        <Content />
        {d.tags.length > 0 && (
          <ul class="wp__tags" role="list">
            {d.tags.map((t) => <li class="chip">#{t}</li>)}
          </ul>
        )}
        <a class="btn wp__commission" href="mailto:contact@rocio-lando.com" data-cursor-hover>
          Commission something like this <span class="btn__icon" aria-hidden="true">↗</span>
        </a>
      </div>

      {related.length > 0 && (
        <section class="wp__related">
          <h2 class="wp__related-title">More {CATEGORY_LABELS[d.category] ?? d.category}</h2>
          <div class="wp__related-grid">
            {related.map((r) => (
              <a href={withBase(`/work/${r.id}`)} class="wp__related-card" data-cursor-view="view">
                <Pic src={r.data.image!} alt={r.data.alt || r.data.title} sizes="30vw" fit="cover" />
                <span class="wp__related-name">{r.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <nav class="wp__pager">
        <a href={withBase(`/work/${prev.id}`)} class="wp__pager-link" data-cursor-hover>
          <span>← Previous</span>
          <b>{prev.data.title}</b>
        </a>
        <a href={withBase(`/work/${next.id}`)} class="wp__pager-link wp__pager-link--next" data-cursor-hover>
          <span>Next →</span>
          <b>{next.data.title}</b>
        </a>
      </nav>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<style>
  .wp {
    padding-block: calc(var(--header-h) + var(--space-l)) var(--space-3xl);
  }
  .wp__crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-l);
  }
  .wp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }
  .wp__title {
    font-size: var(--step-7);
    font-variation-settings: 'opsz' 144, 'SOFT' 40, 'WONK' 1;
    max-width: 18ch;
  }
  .wp__meta {
    display: flex;
    gap: var(--space-l);
  }
  .wp__meta dt {
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.2rem;
  }
  .wp__meta dd {
    font-size: var(--step-0);
  }
  .wp__figure {
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-l);
    margin-bottom: var(--space-l);
    text-align: center;
  }
  .wp__figure :global(img) {
    margin-inline: auto;
    max-height: 80svh;
    width: auto;
  }
  .wp__body {
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }
  .wp__desc {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variation-settings: 'opsz' 60, 'SOFT' 30, 'WONK' 1;
    color: var(--ink-soft);
    font-style: italic;
  }
  .wp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .wp__related {
    margin-top: var(--space-3xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .wp__related-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }
  .wp__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-s);
  }
  .wp__related-card {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-m);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .wp__related-card :global(img) {
    transition: transform 0.6s var(--ease-out-quart);
  }
  .wp__related-card:hover :global(img.is-loaded) {
    transform: scale(1.05);
  }
  .wp__related-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 0.8rem 0.7rem;
    color: #fff;
    font-family: var(--font-display);
    background: linear-gradient(0deg, rgb(0 0 0 / 0.6), transparent);
  }

  .wp__pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .wp__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .wp__pager-link--next {
    text-align: right;
    align-items: flex-end;
  }
  .wp__pager-link span {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .wp__pager-link b {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    transition: color 0.3s;
  }
  .wp__pager-link:hover b {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .wp__related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .wp__title {
      font-size: var(--step-6);
    }
  }
</style>
