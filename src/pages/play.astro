---
import Base from '../layouts/Base.astro';
import Game from '../components/Game.astro';
---

<Base
  title="Ink Catch — a game"
  description="Ink Catch — a tiny arcade game hidden in Rocío Landó's portfolio. Catch the falling sketches, dodge the ink blots."
  noLoader
  bareNav
>
  <section class="playpage">
    <div class="container">
      <header class="playpage__head">
        <p class="eyebrow">The arcade</p>
        <h1 class="playpage__title">Ink <em class="italic">Catch</em></h1>
        <p class="lead">
          Catch the falling sketches in the sketchbook — dodge the spilled ink blots.
          Built from scratch, just for fun.
        </p>
      </header>
      <Game standalone />
    </div>
  </section>
</Base>

<style>
  .playpage {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + var(--space-m)) var(--space-xl);
  }
  .playpage__head {
    text-align: center;
    margin-bottom: var(--space-l);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }
  .playpage__title {
    font-size: var(--step-7);
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
  }
  .playpage__title em {
    color: var(--accent);
  }
</style>
